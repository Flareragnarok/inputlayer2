<?xml version="1.0" encoding="utf-8"?>
<!-- Input Layer QWERTZ, shaped like Gboard's German keyboard: ü, ö and ä on
their own keys, ß on S, digits on the top row's top-right swipes, accents on
the vowels' other corners, and Input Layer's own bottom row (see
il_azerty.xml). -->
<keyboard name="Input Layer QWERTZ" script="latin" bottom_row="false" locale_extra_keys="false">
  <row>
    <key c="q" ne="1"/>
    <key c="w" ne="2"/>
    <key c="e" ne="3" nw="é" sw="è" se="ê" s="€"/>
    <key c="r" ne="4"/>
    <key c="t" ne="5"/>
    <key c="z" ne="6"/>
    <key c="u" ne="7" nw="ù" sw="û"/>
    <key c="i" ne="8" nw="î" sw="ï"/>
    <key c="o" ne="9" nw="ô" sw="œ"/>
    <key c="p" ne="0"/>
    <key c="ü"/>
  </row>
  <row>
    <key c="a" nw="à" sw="â" se="æ"/>
    <key c="s" nw="ß"/>
    <key c="d"/>
    <key c="f"/>
    <key c="g"/>
    <key c="h"/>
    <key c="j"/>
    <key c="k"/>
    <key c="l"/>
    <key c="ö"/>
    <key c="ä"/>
  </row>
  <row>
    <key width="1.5" role="action" c="shift"/>
    <key c="y"/>
    <key c="x"/>
    <key c="c" nw="ç"/>
    <key c="v"/>
    <key c="b"/>
    <key c="n" nw="ñ"/>
    <key c="m"/>
    <key width="2.5" role="action" c="backspace"/>
  </row>
  <row height="0.95">
    <key width="1.5" role="action" c="il_symbols" nw="studio_undo" ne="studio_redo"/>
    <key c="," n="switch_emoji"/>
    <key width="5" role="space_bar" c="space" e="cursor_right"/>
    <key c="." n="\?" ne="!" nw="'" s=":"/>
    <key role="action" c="studio_sector_step" w="left" e="right" n="up" s="down"/>
    <key width="1.5" role="action" c="enter" ne="action"/>
  </row>
</keyboard>
