<?xml version="1.0" encoding="utf-8"?>
<!-- Input Layer's bottom row, added to every layout that doesn't define its
own (upstream's layouts, Russian, Greek...): the same as on Input Layer's
layouts, without Ctrl / Fn / Compose. ?123 opens the symbols pages. -->
<row height="0.95">
  <key width="1.5" role="action" key0="il_symbols" key1="studio_undo" key2="studio_redo"/>
  <key key0="," key7="switch_emoji"/>
  <key width="4" role="space_bar" key0="space" key6="cursor_right"/>
  <key key0="." key7="\?" key2="!" key8=":"/>
  <key role="action" key0="studio_sector_step" key5="left" key6="right" key7="up" key8="down"/>
  <key width="1.5" role="action" key0="enter" key2="action"/>
</row>
